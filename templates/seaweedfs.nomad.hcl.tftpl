job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    secret_version = "${secret_version}"
    backup         = "stop"
  }

  group "seaweedfs" {
    network {
      mode = "bridge"

      port "s3" {
        static       = ${s3_port}
        to           = 8333
        host_network = "${internal_network}"
      }

      port "master" {
        static       = ${master_port}
        to           = 9333
        host_network = "${internal_network}"
      }

      port "metrics" {
        static       = ${metrics_port}
        to           = 9327
        host_network = "${internal_network}"
      }
%{ if mesh.enabled ~}

      # Envoy's metrics, scraped by the platform's Alloy for Consul's topology.
      port "envoy_metrics" {
        to           = 9102
        host_network = "${internal_network}"
      }
%{ endif ~}
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "s3"
      provider = "consul"
%{ if mesh.enabled ~}

      # In the mesh: an Envoy sidecar takes the S3 clients' traffic (transparent
      # proxy), so mesh services reach the lake as ${job_name}.virtual.consul, over
      # mTLS, as the intentions allow. The master (the health check), SeaweedFS's
      # metrics, the ports kept open and Envoy's metrics are still reached directly.
      connect {
        sidecar_service {
          # Its own tags: the sidecar takes the service's otherwise.
          tags = ["mesh-sidecar"]

          proxy {
            transparent_proxy {
              # Envoy runs as uid 1337, which no app uses: the transparent proxy
              # lets Envoy's own uid out unredirected.
              uid                   = "1337"
              no_dns                = true
              exclude_inbound_ports = ${jsonencode(concat([for p in mesh.keep_open_ports : tostring(p)], ["9333", "9327", "9102"]))}
            }
            config {
              envoy_prometheus_bind_addr = "0.0.0.0:9102"
            }
          }
        }

        sidecar_task {
          env {
            ENVOY_UID = "1337"
          }

          resources {
            cpu        = 50
            memory     = 32
            memory_max = 128
          }
        }
      }
%{ endif ~}

      check {
        type     = "http"
        port     = "master"
        path     = "/cluster/status"
        interval = "10s"
        timeout  = "5s"
      }
    }
%{ if mesh.enabled ~}

    service {
      name     = "${job_name}-envoy"
      port     = "envoy_metrics"
      provider = "consul"
      tags     = ["metrics"]
    }
%{ endif ~}

    task "seaweedfs" {
      driver = "docker"

      config {
        image = "${image}"
        args = [
          "server",
          "-dir=/data",
          "-s3",
          "-s3.port=8333",
          "-s3.config=/local/s3.json",
          "-master.volumeSizeLimitMB=${volume_size_limit_mb}",
          "-volume.max=0",
          "-ip.bind=0.0.0.0",
          "-metricsPort=9327",
        ]
        cap_drop = ["all"]
      }

      volume_mount {
        volume      = "data"
        destination = "/data"
      }

      vault {}

      template {
        destination = "local/s3.json"
        data        = <<-S3
          {{ with secret "${secret_path}" }}{"identities":[${identities_json}]}{{ end }}
        S3
      }

      resources {
        cpu        = ${resources.cpu}
        memory     = ${resources.memory}
        memory_max = ${resources.memory_max}
      }
    }
  }
}
